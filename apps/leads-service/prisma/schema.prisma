generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id      String   @id @default(uuid())
  name    String
  email   String
  phone   String?
  company String
  status  String   @default("new")
  tags    String[]
  notes   String?
  source  String?

  createdAt       DateTime  @default(now())
  statusChangedAt DateTime  @default(now())
  closedAt        DateTime?
  closedById      String?

  assignedToId   String?
  assignedToName String?

  leadNotes  Note[]
  activities Activity[]
  tasks      Task[]

  @@index([status, statusChangedAt])
  @@index([closedById])
  @@index([assignedToId])
}

model Note {
  id        String   @id @default(uuid())
  text      String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime @default(now())

  userId   String?
  userName String  @default("")
}

model Task {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  dueDate     DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}
