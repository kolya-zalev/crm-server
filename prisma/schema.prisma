generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id String @id @default(uuid())
  name String
  email String
  phone String?
  company String
  status String @default("new")
  tags String[]
  notes String?
  source String?

  leadNotes Note[]
  activities Activity[]
  tasks Task[]
}

model Note{
  id  String @id @default(uuid())
  text String
  leadId String
  lead      Lead     @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

}

model Activity {
  id String @id @default(uuid())
  leadId String
  lead Lead   @relation(fields: [leadId], references: [id])
  type String
  description String
  createdAt DateTime @default(now())

}

model Task {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  dueDate     DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}