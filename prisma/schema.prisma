generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id     String  @id @default(uuid())
  name   String
  email  String
  phone  String?
  company String
  status String @default("new")
  tags   String[]
  notes  String?
  source String?
  
  createdAt DateTime @default(now())
  statusChangedAt DateTime  @default(now())
  closedAt        DateTime?
  closedById      String?

  leadNotes  Note[]
  activities Activity[]
  tasks      Task[]
  notifications Notification[]


  assignedToId String?

  @@index([status, statusChangedAt])
  @@index([closedById])
  @@index([assignedToId])
}

model Note{
  id  String @id @default(uuid())
  text String
  leadId String
  lead      Lead     @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

}

model Activity {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  type        String
  description String
  createdAt   DateTime @default(now())

  userId   String?
  userName String  @default("")
}

model Task {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  dueDate     DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("member")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emailChangedAt DateTime?

}

model ChatMessage {
  id      String      @id @default(uuid())
  text  String
  authorId String
  authorName String
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String    @id @default(uuid())
  name      String    @default("")
  email     String    @unique
  role      String    
  status    String    
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actorId   String?
  actorName String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}