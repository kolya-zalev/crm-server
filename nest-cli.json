{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/crm-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/crm-server/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/crm-server",
  "projects": {
    "crm-server": {
      "type": "application",
      "root": "apps/crm-server",
      "entryFile": "main",
      "sourceRoot": "apps/crm-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/crm-server/tsconfig.app.json"
      }
    },
    "users-service": {
      "type": "application",
      "root": "apps/users-service",
      "entryFile": "main",
      "sourceRoot": "apps/users-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users-service/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "leads-service": {
      "type": "application",
      "root": "apps/leads-service",
      "entryFile": "main",
      "sourceRoot": "apps/leads-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/leads-service/tsconfig.app.json"
      }
    }
  }
}